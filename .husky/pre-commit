# Every check that runs without services. CI doesn't run these, so this hook
# is where they are enforced; CI keeps only the E2E (Postgres) and image tests.

# eslint and Prettier fix the staged files (lint-staged.config.mjs).
pnpm exec lint-staged

# The rest checks exactly what is being committed: unstaged changes to tracked
# files are set aside as a patch and put back afterwards, pass or fail.
patch="$(git rev-parse --git-dir)/pre-commit-unstaged.patch"
if [ -s "$patch" ]; then
  echo "pre-commit: $patch holds unstaged changes from an earlier commit; apply it (git apply) or delete it first" >&2
  exit 1
fi
git diff --binary --no-color --no-ext-diff >"$patch"
restore() {
  if [ -s "$patch" ]; then
    if git apply --whitespace=nowarn "$patch"; then
      rm -f "$patch"
    else
      echo "pre-commit: could not put back your unstaged changes; they are saved in $patch" >&2
    fi
  fi
}
if [ -s "$patch" ]; then
  trap restore EXIT
  trap 'exit 130' INT TERM
  git checkout -- .
else
  rm -f "$patch"
fi

pnpm --filter @reelcraft/shared build
pnpm typecheck
pnpm --filter @reelcraft/api typecheck
pnpm --filter @reelcraft/shared test
pnpm --filter @reelcraft/api test
pnpm test:release
