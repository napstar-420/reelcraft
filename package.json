{
  "name": "reelcraft",
  "private": true,
  "version": "0.13.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "husky || true",
    "dev": "pnpm --parallel --filter @reelcraft/api --filter @reelcraft/web dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter @reelcraft/shared --filter @reelcraft/api --filter @reelcraft/web test",
    "test:e2e": "pnpm --filter @reelcraft/api test:e2e",
    "test:release": "node --test 'scripts/release/*.test.mjs' 'docker/app/rootfs/usr/local/lib/reelcraft/updater/*.test.mjs'",
    "db:generate": "pnpm --filter @reelcraft/api db:generate",
    "db:migrate": "pnpm --filter @reelcraft/api db:migrate",
    "db:studio": "pnpm --filter @reelcraft/api db:studio",
    "smoke": "pnpm --filter @reelcraft/api smoke",
    "tts": "uv run --directory services/qwen-tts --extra engine qwen-tts-service"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
