# Keep the image build context small and free of local state and secrets.
.git
**/node_modules
**/dist
**/dist-acceptance
**/coverage
**/*.tsbuildinfo
.env
.env.*
docker/data
apps/api/.workspace
graphify-out
.agents
.claude
.tours
docs

# The Qwen3-TTS service: the Dockerfile copies only its source, pyproject and pinned packages. A
# local virtualenv (1 GB+), caches, model weights and the service's tests never go in the context.
**/.venv
**/__pycache__
**/.pytest_cache
services/qwen-tts/models
services/qwen-tts/tests

# Updater unit tests stay out of the image.
docker/app/rootfs/**/*.test.mjs
docker/app/rootfs/**/testing.mjs

# The user guide (Docusaurus) is published to GitHub Pages, not shipped in the image.
apps/docs
