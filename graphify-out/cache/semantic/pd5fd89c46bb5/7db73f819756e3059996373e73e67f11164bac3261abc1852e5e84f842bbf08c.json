{"nodes": [{"id": "plans_phase_4_inputs_hitl_run_revision", "label": "Run Revision & Mutation Serialization", "file_type": "concept", "source_file": ".claude/plans/phase-4-inputs-hitl.md", "source_location": "Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_phase_4_inputs_hitl_run_mutation_service", "label": "RunMutationService", "file_type": "code", "source_file": ".claude/plans/phase-4-inputs-hitl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_phase_4_inputs_hitl_run_wakeup_outbox", "label": "run_wakeup Outbox Table", "file_type": "concept", "source_file": ".claude/plans/phase-4-inputs-hitl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ensures a committed mutation cannot leave a run parked merely because the immediate inngest.send() failed; transactional outbox for control events, not a general messaging subsystem."}, {"id": "plans_phase_4_inputs_hitl_revision_bound_events", "label": "Revision-Bound Orchestration Events", "file_type": "concept", "source_file": ".claude/plans/phase-4-inputs-hitl.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents a delayed/duplicate wakeup from resurrecting a cancelled or newer-state run by binding claims to run revision, action, and source state."}, {"id": "plans_phase_4_inputs_hitl_signed_invalidation_previews", "label": "Signed Invalidation Previews", "file_type": "rationale", "source_file": ".claude/plans/phase-4-inputs-hitl.md", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses stateless HMAC-SHA256 tokens instead of a preview table/dependency; avoids trusting client-supplied IDs by recomputing the closure at confirmation time."}, {"id": "plans_phase_4_inputs_hitl_run_action_policy", "label": "RunActionPolicy (Action Matrix \u00a712.4)", "file_type": "code", "source_file": ".claude/plans/phase-4-inputs-hitl.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_phase_4_inputs_hitl_observational_invalidation", "label": "Observational Invalidation", "file_type": "concept", "source_file": ".claude/plans/phase-4-inputs-hitl.md", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invalidation is based on what active successful attempts actually read (persisted provenance), not a declared dependency graph, so it stays correct without needing a full static graph."}, {"id": "plans_phase_4_inputs_hitl_invalidation_transaction", "label": "Invalidation Transaction", "file_type": "concept", "source_file": ".claude/plans/phase-4-inputs-hitl.md", "source_location": "Section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_phase_4_inputs_hitl_cost_preview", "label": "Cost Preview (spentUsd/estimatedRerunUsd)", "file_type": "concept", "source_file": ".claude/plans/phase-4-inputs-hitl.md", "source_location": "Section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_phase_4_inputs_hitl_chunk2_invalidation_engine", "label": "Chunk 2 \u2014 Invalidation Engine, Previews, Tombstones", "file_type": "concept", "source_file": ".claude/plans/phase-4-inputs-hitl.md", "source_location": "Chunk 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_phase_4_inputs_hitl_memory_tombstone_semantics", "label": "Run Memory Tombstone Current-Value Semantics", "file_type": "rationale", "source_file": ".claude/plans/phase-4-inputs-hitl.md", "source_location": "Chunk 2 item 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetch high