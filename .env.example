NODE_ENV=development
API_PORT=3000

DATABASE_URL=postgres://reefcraft:reefcraft@localhost:5432/reefcraft

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=video-engine
S3_ACCESS_KEY_ID=reefcraft-app
S3_SECRET_ACCESS_KEY=reefcraft-app-secret
S3_FORCE_PATH_STYLE=true

PRESIGN_TTL_SEC=900

INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=local-dev-event-key
INNGEST_SIGNING_KEY=3d312b0d5874e57362ef7c25b40414030932ec530d1634cff07754d9402d6761

# Required only to run llm.generate against the real OpenRouter adapter.
# Leave blank to use the fake provider only.
OPENROUTER_API_KEY=

WORKSPACE_ROOT=./.workspace
BLOB_RETENTION_DAYS=30
ITERATE_MAX_ITEMS=50
PRE_SUBMIT_TTL_SEC=600
FETCH_ALLOWANCE_SEC=120
QC_ERROR_RETRIES=2
INFRA_RETRIES=2
SANDBOX_MEMORY_MB=32
SANDBOX_TIMEOUT_MS=100
