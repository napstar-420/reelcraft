{
  "name": "@reelcraft/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "smoke": "tsx test/smoke.ts",
    "acceptance:phase4-restart": "tsc -b tsconfig.build.json --force && tsx test/acceptance/phase4-restart.ts",
    "acceptance:phase6-render": "pnpm --filter @reelcraft/render-worker build && tsx test/acceptance/phase6-render.ts",
    "acceptance:phase7-broll": "bash test/acceptance/run-phase7-broll.sh",
    "acceptance:codex": "pnpm build && node test/acceptance/codex-provider.mjs",
    "acceptance:codex-image": "pnpm build && node test/acceptance/codex-image.mjs",
    "acceptance:codex-browser": "pnpm build && node test/acceptance/codex-browseros.mjs",
    "acceptance:codex-assistant": "pnpm build && node test/acceptance/codex-assistant.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/lib-storage": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@reelcraft/shared": "workspace:*",
    "ajv": "^8.17.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.2",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "http-proxy-middleware": "^3.0.5",
    "inngest": "^3.29.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.5",
    "quickjs-emscripten-core": "^0.32.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulidx": "^2.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@inngest/test": "^0.1.9",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
