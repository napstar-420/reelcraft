{
  "name": "@reefcraft/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "smoke": "tsx test/smoke.ts",
    "acceptance:phase4-restart": "tsc -b tsconfig.build.json --force && tsx test/acceptance/phase4-restart.ts"
  },
  "dependencies": {
    "@reefcraft/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "drizzle-orm": "^0.38.2",
    "postgres": "^3.4.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1",
    "ulidx": "^2.4.1",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/lib-storage": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "ajv": "^8.17.1",
    "inngest": "^3.29.0",
    "quickjs-emscripten-core": "^0.32.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0"
  },
  "devDependencies": {
    "@inngest/test": "^0.1.9",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
